# --- Servidor ---
PORT=3000
NODE_ENV=development
# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# --- Base de datos PostgreSQL ---
# Opción A: una sola URL (tiene prioridad si se define)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/crowdfunding_db
# Opción B: variables sueltas
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=crowd_db
# Máximo de conexiones simultáneas del pool
DB_POOL_MAX=10

# --- Seguridad ---
# Genera uno con:  openssl rand -hex 32   (mínimo 32 caracteres)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# --- Reglas de negocio ---
# Zona horaria que define cuándo "vence" una campaña
APP_TIMEZONE=America/Bogota
# Cada cuántos segundos se revisan las campañas vencidas (0 = desactivado)
SETTLEMENT_INTERVAL_SECONDS=60
